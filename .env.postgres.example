POSTGRES_DB=global_auto
POSTGRES_USER=gais
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional AutoPolicy AI / OpenClaw proxy configuration.
GAIS_OPENCLAW_ENABLED=false
GAIS_OPENCLAW_BASE_URL=http://127.0.0.1:18789
GAIS_OPENCLAW_GATEWAY_TOKEN=
GAIS_OPENCLAW_MODEL=openclaw/default
GAIS_OPENCLAW_UPSTREAM_MODEL=
GAIS_OPENCLAW_FALLBACK_TO_LEGACY=true
GAIS_WEB_SEARCH_PROVIDER=brave
GAIS_BRAVE_API_KEY=
GAIS_TAVILY_API_KEY=
GAIS_SEARXNG_BASE_URL=

# Phase A/B identity, organization and RBAC configuration.
# Local development login is intentionally opt-in and is hard-disabled by the
# backend in production/staging even if this flag is set accidentally.
GAIS_AUTH_LOCAL_DEV_ENABLED=false
GAIS_AUTH_LOCAL_DEV_ORGANIZATION_KEY=LOCAL-DEV
GAIS_AUTH_LOCAL_DEV_ORGANIZATION_NAME=AutoPolicy local development

# Generate a long random value and inject it from a secret manager in a server
# environment. Never commit the production value.
GAIS_AUTH_SECRET_KEY=change-me-in-production

# Enterprise OIDC (Entra ID / Okta / Keycloak). Keep disabled until all values
# have been configured and the callback URL has been registered at the IdP.
GAIS_AUTH_OIDC_ENABLED=false
GAIS_AUTH_OIDC_ISSUER_URL=
GAIS_AUTH_OIDC_CLIENT_ID=
GAIS_AUTH_OIDC_CLIENT_SECRET=
GAIS_AUTH_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
GAIS_AUTH_OIDC_SUCCESS_REDIRECT_URI=http://127.0.0.1:3000/assistant
GAIS_AUTH_OIDC_SCOPES=openid profile email
GAIS_AUTH_DEFAULT_ORGANIZATION_KEY=
GAIS_AUTH_DEFAULT_ORGANIZATION_NAME=

# Cookie defaults are appropriate for localhost. Production forces Secure
# cookies and should normally be served behind one HTTPS origin.
GAIS_AUTH_SESSION_COOKIE_NAME=gais_session
GAIS_AUTH_CSRF_COOKIE_NAME=gais_csrf
GAIS_AUTH_CSRF_HEADER_NAME=X-CSRF-Token
GAIS_AUTH_SESSION_MAX_AGE_SECONDS=28800
GAIS_AUTH_COOKIE_SECURE=false
GAIS_AUTH_COOKIE_SAMESITE=lax
