# Copy to .env and replace this value before starting the gateway.
# Keep the gateway bound to 127.0.0.1 until the backend proxy and access controls are ready.
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Optional provider credentials. Keep blank until you decide which model/search
# account to use; never commit the real values.
OPENCLAW_WEB_SEARCH_PROVIDER=brave
OPENCLAW_MODEL_PROVIDER=openai
OPENCLAW_DEEPSEEK_MODEL=deepseek-v4-pro
BRAVE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
